# `npm run init:env` 가 이 파일을 복사해 .env 를 만들고 E2E_PASSWORD 를 무작위로 채운다.

# 테스트 대상
E2E_BASE_URL=https://devdmu.gosky.kr
E2E_API_URL=https://api.devdmu.gosky.kr

# 테스트 계정 공용 비밀번호 (init:env 가 생성. 매 실행마다 이 값으로 계정을 재생성한다)
E2E_PASSWORD=

# DB/Redis 직접 조작용 SSH 호스트와 컨테이너 이름 (~/.ssh/config 의 Host 이름)
E2E_SSH_HOST=gosky
E2E_DB_CONTAINER=dmu-dev-db
E2E_REDIS_CONTAINER=dmu-dev-redis

# 1 이면 실행 전 테스트 계정 재생성을 건너뛴다 (디버깅용)
E2E_SKIP_RESET=0

# 1 이면 실제 SMS 발송 요청이 생기는 테스트(SOS → 보호자 실시간 알림, 실행당 1건)를 건너뛴다
E2E_SKIP_SMS=0
